// Orçamento
// ---------------------------------------------------------------------------

/// A proposta que vai ao cliente antes de existir pedido.
///
/// Espelha o `Pedido` de propósito — item congelado, IPI por linha, os mesmos
/// totais — porque é o mesmo documento em outro momento da conversa. As
/// diferenças são as que o momento pede: tem `attn` e validade, não tem frete
/// nem transportadora, e o número é do ESCRITÓRIO, não da indústria.
model Orcamento {
  id            String @id @default(uuid()) @db.Uuid
  organizacaoId String @db.Uuid
  fornecedorId  String @db.Uuid

  /// NULO quando a proposta é para quem ainda não é cliente.
  ///
  /// Cotar antes de cadastrar é o começo da conversa, não uma falha de
  /// preenchimento: no backup do sistema antigo, 99 das 166 propostas nasceram
  /// assim. O cadastro vem depois, se o negócio acontecer — e aí o orçamento é
  /// ligado ao cliente e pode virar pedido.
  clienteId String? @db.Uuid

  /// O destinatário enquanto ele não é cliente. Nome e cidade é tudo o que se
  /// sabe de quem ainda está pedindo preço.
  clienteAvulsoNome      String?
  clienteAvulsoMunicipio String?

  /// Sequencial por escritório. O sistema antigo não numerava orçamento, e o
  /// documento só podia ser citado por "o do dia tal" — um número o torna
  /// citável ao telefone.
  numero Int
  status StatusOrcamento @default(ABERTO)

  /// Por que o cliente recusou — preço alto, comprou do concorrente, adiou.
  ///
  /// É a única pergunta que a proposta perdida ainda responde, e o sistema
  /// antigo não a fazia: ali a proposta recusada virava um registro mudo, e o
  /// padrão das perdas do ano só existia na cabeça de quem negociou.
  ///
  /// Sobrevive a reabrir a proposta de propósito: se ela cair de novo, o que
  /// foi escrito da primeira vez é o ponto de partida, não ruído a apagar.
  motivoRecusa String?

  /// "Aos cuidados de": a pessoa no cliente a quem a proposta é dirigida.
  /// Sai impressa logo abaixo do nome da empresa.
  attn String?

  /// Até quando o preço vale. Não expira sozinho: quem muda o status é o
  /// representante, porque ele é quem sabe se renegociou.
  validoAte DateTime? @db.Date

  prazoPagamento String?
  observacoes    String?
  vendedor       String?

  /// Congelado na criação, como no pedido.
  ipiPercentual Decimal @default(0) @db.Decimal(6, 3)

  subtotalSemIpi Decimal @default(0) @db.Decimal(14, 2)
  valorIpi       Decimal @default(0) @db.Decimal(14, 2)
  totalGeral     Decimal @default(0) @db.Decimal(14, 2)

  /// Mesmo corte do pedido: segue o dono da carteira do cliente.
  representanteId String? @db.Uuid

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  organizacao   Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  fornecedor    Fornecedor      @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  cliente       Cliente?        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  representante Usuario?        @relation(fields: [representanteId], references: [id], onDelete: SetNull)
  itens         OrcamentoItem[]
  pedidos       Pedido[]

  @@unique([organizacaoId, numero])
  @@index([organizacaoId])
  @@index([organizacaoId, status])
  @@index([clienteId])
  @@index([representanteId])
  @@map("orcamento")
}

/// Item da proposta. Congela o que sai impresso, igual ao item de pedido.
model OrcamentoItem {
  id          String  @id @default(uuid()) @db.Uuid
  orcamentoId String  @db.Uuid
  produtoId   String? @db.Uuid

  ordem   Int
  familia Familia

  codigoFornecedor String?
  codigoCliente    String?
  descricao        String

  unidade    UnidadeVenda
  quantidade Decimal      @db.Decimal(14, 3)

  comIpi Boolean @default(true)

  precoUnitario Decimal @db.Decimal(16, 6)

  totalSemIpi Decimal @db.Decimal(14, 2)
  valorIpi    Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  pesoKg      Decimal @default(0) @db.Decimal(14, 3)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto   Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([orcamentoId])
  @@index([produtoId])
  @@map("orcamento_item")
}
