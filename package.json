{
  "name": "repplast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run --config vitest.integration.config.mts",
    "test:navegador": "vitest run --config vitest.browser.config.mts",
    "db:setup": "node --conditions react-server scripts/setup-db-role.mjs",
    "db:seed": "tsx --conditions react-server prisma/seed.ts",
    "db:importar": "tsx --conditions react-server scripts/importar-sicov.ts",
    "db:peso": "tsx --conditions react-server scripts/retrocalcular-peso.ts",
    "tunel": "node scripts/tunel-webhook.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.7.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "fflate": "0.8.3",
    "lucide-react": "^1.44.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.63.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
